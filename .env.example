# ==============================================================================
# CIMBAHIA: CONFIGURAÇÕES DE AMBIENTE
# ==============================================================================

# Obtenha estas credenciais no Supabase: Project Settings -> API.
# A anon key é pública por definição; proteja os dados com políticas RLS.
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# Integração server-side com SESAB/AFSESAB; o endereço precisa usar HTTPS.
SESAB_BASE_URL=
SESAB_API_EMAIL=
SESAB_API_PASSWORD=
